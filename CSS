
/* =========================
   1. GLOBAL STYLES
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #070809;
    color: #f3f4f6;
    line-height: 1.75;
    font-size: 14px;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

::selection {
    background: #ff304f;
    color: #ffffff;
}

/* =========================
   2. NAVIGATION BAR
========================= */

.navbar {
    width: 100%;
    min-height: 84px;
    padding: 18px 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    background: #070809;
    border-bottom: 1px solid #25272d;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.brand {
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: -0.3px;
}

.brand-star {
    color: #ffffff;
    font-size: 20px;
}

.nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
}

.nav-links a {
    color: #b6bac5;
    font-size: 12px;
    transition: color 0.25s ease;
}

.nav-links a:hover {
    color: #ff304f;
}

.contact-nav {
    padding: 8px 14px;
    border: 1px solid #363942;
    border-radius: 7px;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 600;
    transition: 0.25s ease;
}

.contact-nav:hover {
    border-color: #ff304f;
    color: #ff304f;
}

/* =========================
   3. HERO SECTION
========================= */

.hero {
    min-height: 605px;
    padding: 80px 5.5%;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 70px;
    border-bottom: 1px solid #25272d;
    background:
        radial-gradient(
            ellipse at 80% 40%,
            rgba(255, 48, 79, 0.035),
            transparent 35%
        ),
        #070809;
}

.hero-text {
    max-width: 620px;
}

.eyebrow,
.section-label {
    color: #ff304f;
    font-family: "Courier New", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

.eyebrow {
    margin-bottom: 18px;
}

.red-dot {
    margin-right: 7px;
    font-size: 10px;
}

.hero h1 {
    font-size: clamp(52px, 7vw, 70px);
    font-weight: 800;
    letter-spacing: -3px;
    line-height: 1.2;
    margin-bottom: 22px;
}

.hero h1 span {
    color: #ff304f;
}

.intro {
    color: #c4c8d1;
    font-size: 14px;
    line-height: 1.9;
    max-width: 570px;
}

.intro strong {
    color: #ffffff;
}

.second-intro {
    margin-top: 14px;
}

/* Hero buttons */

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
}

.button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 11px 16px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
    transition:
        background 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        transform 0.25s ease;
}

.button:hover {
    transform: translateY(-3px);
}

.button-primary {
    background: #ff304f;
    border: 1px solid #ff304f;
    color: #ffffff;
}

.button-primary:hover {
    background: #e91f3f;
    border-color: #e91f3f;
}

.button-secondary {
    background: #0c0d10;
    color: #f3f4f6;
    border: 1px solid #363942;
}

.button-secondary:hover {
    border-color: #ff304f;
    color: #ff304f;
}

/* Social links */

.social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 27px;
}

.social-links a {
    font-family: "Courier New", monospace;
    font-size: 11px;
    color: #9da8ba;
    transition: color 0.25s ease;
}

.social-links a:hover {
    color: #ff304f;
}

/* =========================
   4. PROFILE CARD
========================= */

.profile-card {
    width: 100%;
    max-width: 365px;
    justify-self: end;
    overflow: hidden;
    border: 1px solid #34353d;
    border-radius: 13px;
    background: #0d0e12;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
}

/* Window title bar */

.window-bar {
    height: 44px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #151619;
    border-bottom: 1px solid #303139;
}

.window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
}

.dot {
    width: 8px;
    height: 8px;
    display: inline-block;
    border-radius: 50%;
}

.dot-red {
    background: #ff5f57;
}

.dot-yellow {
    background: #febc2e;
}

.dot-green {
    background: #28c840;
}

.file-name {
    font-family: "Courier New", monospace;
    font-size: 10px;
    color: #9eb7d8;
}

/* Avatar scene */

.avatar-scene {
    height: 330px;
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        radial-gradient(
            ellipse at 50% 53%,
            rgba(255, 48, 79, 0.20),
            transparent 65%
        ),
        #0b0c10;
}

.avatar-glow {
    position: absolute;
    width: 190px;
    height: 190px;
    top: 55px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 48, 79, 0.07);
    filter: blur(40px);
    border-radius: 50%;
}

/* The illustration is drawn with CSS */

.avatar {
    width: 250px;
    height: 275px;
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
}

.avatar-hair {
    position: absolute;
    z-index: 1;
    top: 18px;
    left: 37px;
    width: 176px;
    height: 202px;
    background: #08090e;
    border-radius: 100px 100px 75px 75px;
}

.avatar-neck {
    position: absolute;
    z-index: 2;
    top: 151px;
    left: 106px;
    width: 39px;
    height: 60px;
    background: #d6d4d0;
}

.avatar-face {
    position: absolute;
    z-index: 3;
    top: 62px;
    left: 68px;
    width: 114px;
    height: 126px;
    overflow: hidden;
    background: #f0efeb;
    border-radius: 45% 45% 48% 48%;
}

.hair-fringe {
    position: absolute;
    z-index: 2;
    top: -1px;
    left: 0;
    width: 100%;
    height: 52px;
    background: #08090e;
    clip-path: polygon(
        0 0,
        100% 0,
        100% 100%,
        86% 38%,
        77% 100%,
        62% 35%,
        47% 100%,
        33% 35%,
        19% 100%,
        11% 39%,
        0 70%
    );
}

.eyes {
    position: absolute;
    top: 49px;
    left: 22px;
    width: 70px;
    display: flex;
    justify-content: space-between;
}

.eyes span {
    width: 21px;
    height: 4px;
    background: #111218;
    border-radius: 50%;
}

.nose {
    position: absolute;
    left: 0;
    right: 0;
    top: 65px;
    width: 0;
    height: 0;
    margin: auto;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 7px solid #e0ded9;
}

/* Body */

.avatar-body {
    position: absolute;
    z-index: 4;
    bottom: -48px;
    left: 12px;
    width: 226px;
    height: 133px;
    background: #11151c;
    border: 1px solid #292d35;
    border-radius: 100px 100px 0 0;
}

/* Profile footer */

.profile-footer {
    padding: 15px 19px 17px;
    background: #0d0e12;
    border-top: 1px solid #191a20;
}

.profile-footer p {
    font-size: 11px;
    color: #aeb8c8;
    margin-bottom: 3px;
}

.status-dot {
    color: #91b9ff;
    font-size: 9px;
}

.profile-footer strong {
    font-family: "Courier New", monospace;
    font-size: 11px;
    color: #f3f4f6;
}

/* =========================
   5. GENERAL CONTENT SECTIONS
========================= */

.content-section {
    padding: 80px 5.5%;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 45px;
    border-bottom: 1px solid #25272d;
    background: #070809;
}

.content-section.alternate {
    background: #0a0b0e;
}

.section-heading {
    padding-right: 25px;
    border-right: 1px solid #303139;
}

.section-label {
    margin-bottom: 20px;
}

.section-heading h2 {
    margin-bottom: 13px;
    font-size: 35px;
    line-height: 1.3;
    letter-spacing: -1px;
}

.section-description {
    max-width: 310px;
    color: #9ea6b6;
    font-size: 13px;
}

.section-content {
    min-width: 0;
}

/* =========================
   6. EDUCATION AND EXPERIENCE
========================= */

.timeline-item {
    padding: 0 0 34px;
    margin-bottom: 30px;
    border-bottom: 1px solid #22252c;
}

.timeline-item:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
}

.item-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 7px;
}

.item-top h3 {
    font-size: 14px;
    line-height: 1.6;
    color: #f5f6f8;
}

.date {
    color: #91a0b5;
    font-family: "Courier New", monospace;
    font-size: 10px;
    white-space: nowrap;
}

.timeline-item h4 {
    font-size: 12px;
    color: #d8dce5;
    font-weight: 600;
    margin-bottom: 10px;
}

.timeline-item p {
    font-size: 12px;
    color: #a6afbe;
    line-height: 1.9;
}

/* Skill tags */

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 15px;
}

.tags span {
    display: inline-block;
    padding: 4px 9px;
    background: #11151a;
    border: 1px solid #303640;
    border-radius: 5px;
    color: #c5ccda;
    font-family: "Courier New", monospace;
    font-size: 10px;
}

/* =========================
   7. PROJECT CARDS
========================= */

.project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.project-card {
    padding: 24px;
    background: #0d0f13;
    border: 1px solid #2a2d35;
    border-radius: 10px;
    transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        background 0.25s ease;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: #ff304f;
    background: #111217;
}

.project-number {
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1px;
    color: #ff526a;
}

.project-card h3 {
    margin: 15px 0 9px;
    font-size: 18px;
}

.project-card p {
    font-size: 12px;
    line-height: 1.9;
    color: #a6afbe;
}

/* =========================
   8. ABOUT SECTION
========================= */

.about-content {
    max-width: 650px;
}

.about-content p {
    margin-bottom: 18px;
    color: #b6becc;
    font-size: 14px;
    line-height: 2;
}

/* =========================
   9. CONTACT SECTION
========================= */

.contact-section {
    padding: 90px 20px;
    text-align: center;
    background:
        radial-gradient(
            ellipse at center,
            rgba(255, 48, 79, 0.08),
            transparent 65%
        ),
        #070809;
    border-bottom: 1px solid #25272d;
}

.contact-section .section-label {
    margin-bottom: 15px;
}

.contact-section h2 {
    font-size: clamp(32px, 5vw, 46px);
    letter-spacing: -1px;
    margin-bottom: 12px;
}

.contact-section h2 span {
    color: #ff304f;
}

.contact-section > p:not(.section-label) {
    max-width: 500px;
    margin: 0 auto 25px;
    color: #a6afbe;
    font-size: 13px;
}

.contact-section .button {
    margin-top: 5px;
}

/* =========================
   10. FOOTER
========================= */

.footer {
    padding: 22px 5.5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    background: #070809;
}

.footer p,
.footer a {
    color: #8d96a6;
    font-size: 11px;
}

.footer a {
    transition: color 0.25s ease;
}

.footer a:hover {
    color: #ff304f;
}

/* =========================
   11. TABLET RESPONSIVENESS
========================= */

@media (max-width: 900px) {
    .navbar {
        padding: 16px 4%;
        gap: 15px;
    }

    .nav-links {
        gap: 14px;
    }

    .hero {
        padding: 65px 5%;
        gap: 35px;
        grid-template-columns: 1fr 0.8fr;
    }

    .profile-card {
        max-width: 330px;
    }

    .content-section {
        padding: 65px 5%;
        gap: 30px;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }
}

/* =========================
   12. MOBILE RESPONSIVENESS
========================= */

@media (max-width: 650px) {
    html {
        scroll-padding-top: 130px;
    }

    .navbar {
        position: sticky;
        padding: 14px 5%;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
    }

    .brand {
        font-size: 15px;
    }

    .contact-nav {
        padding: 6px 10px;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: flex-start;
        overflow-x: auto;
        gap: 21px;
        padding: 4px 0;
    }

    .nav-links a {
        flex-shrink: 0;
        font-size: 11px;
    }

    .hero {
        min-height: auto;
        padding: 75px 6% 65px;
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .hero h1 {
        font-size: clamp(48px, 12vw, 65px);
    }

    .hero-text {
        max-width: 100%;
    }

    .profile-card {
        justify-self: center;
        max-width: 365px;
    }

    .avatar-scene {
        height: 300px;
    }

    .content-section {
        padding: 60px 6%;
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .section-heading {
        padding-right: 0;
        border-right: none;
        border-bottom: 1px solid #303139;
        padding-bottom: 25px;
    }

    .section-heading h2 {
        font-size: 31px;
    }

    .section-description {
        max-width: 400px;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .footer {
        flex-direction: column;
        text-align: center;
        gap: 7px;
    }
}

/* =========================
   13. SMALL PHONES
========================= */

@media (max-width: 380px) {
    .hero-buttons {
        align-items: stretch;
        flex-direction: column;
    }

    .hero-buttons .button {
        width: 100%;
    }

    .social-links {
        gap: 15px;
    }

    .item-top {
        flex-direction: column;
        gap: 3px;
    }

    .date {
        white-space: normal;
    }
}
